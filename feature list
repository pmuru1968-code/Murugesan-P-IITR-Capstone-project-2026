import numpy as np
import pandas as pd

PROMISED_HOURS = {"Express": 36, "Standard": 60, "Economy": 96}

def clean_shipments(raw, medians=None):
    df = raw.copy()
    
    # 1. Drop exact duplicate rows
    df = df.drop_duplicates()
    
    # 2. service_type: strip and title case
    df["service_type"] = df["service_type"].str.strip().str.title()
    
    # 3. payment_mode: replace missing with "Unknown"
    df["payment_mode"] = df["payment_mode"].fillna("Unknown")
    
    # 4. declared_value: clean rupee symbol and commas, convert to numeric, store, drop old
    if "declared_value" in df.columns:
        val_series = df["declared_value"].astype(str)
        cleaned_val = (
            val_series
            .str.replace(r"[\u20b9,\s•\u2000-\u200f\u202f\u205f\u3000]", "", regex=True)
            .replace({"nan": np.nan, "None": np.nan, "": np.nan})
        )
        df["declared_value_inr"] = pd.to_numeric(cleaned_val, errors="coerce")
        df = df.drop(columns=["declared_value"])
    
    # 5. dispatch_time: convert to datetime
    df["dispatch_time"] = pd.to_datetime(df["dispatch_time"])
    
    # 6. parcel_weight_kg: values > 100 are scanner faults, set to NaN
    if "parcel_weight_kg" in df.columns:
        df.loc[df["parcel_weight_kg"] > 100, "parcel_weight_kg"] = np.nan
        
    # 7. fill missing values with medians
    cols_to_fill = ["distance_km", "parcel_weight_kg", "declared_value_inr"]
    
    if medians is None:
        medians = {}
        for col in cols_to_fill:
            val = df[col].median()
            medians[col] = round(float(val), 2) if pd.notna(val) else 0.0
            
    for col in cols_to_fill:
        df[col] = df[col].fillna(medians[col])
        
    return df, medians

def build_features(clean, hubs):
    df = clean.copy()
    
    # Left merge with hubs
    df = df.merge(hubs, on="hub_id", how="left")
    
    # promised_hours
    df["promised_hours"] = df["service_type"].map(PROMISED_HOURS).astype(int)
    
    # is_cod
    df["is_cod"] = (df["payment_mode"] == "COD").astype(int)
    
    # is_weekend
    df["is_weekend"] = (df["dispatch_time"].dt.dayofweek >= 5).astype(int)
    
    # dispatch_hour
    df["dispatch_hour"] = df["dispatch_time"].dt.hour.astype(int)
    
    # log_declared_value
    df["log_declared_value"] = np.log(df["declared_value_inr"])
    
    return df
